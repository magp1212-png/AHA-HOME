# Copia este archivo como .env (no lo subas a GitHub).
# Frase secreta para las sesiones: larga y aleatoria. Si la cambias, todos deben volver a iniciar sesión.
AHAHOME_JWT_SECRET=cambia-esto-por-una-frase-larga-y-secreta

# Por defecto usa SQLite dentro de ./datos. Para PostgreSQL (recomendado en producción):
# AHAHOME_DATABASE_URL=postgresql+psycopg://usuario:clave@localhost/ahahome
